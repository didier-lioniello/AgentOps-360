# Local reference-demo configuration. Never reuse these values in a deployment.
AUTH_MODE=development
DEV_TOKEN=local-demo-token-only
DEV_TENANT_ID=acme
JWT_AUDIENCE=agentops

# Required only for AUTH_MODE=jwt. Use a randomly generated value of 32+ characters.
JWT_SECRET=

# Required only when invoking a real model.
OPENAI_API_KEY=
DATABASE_URL=postgresql+asyncpg://agentops:agentops@postgres:5432/agentops
REDIS_URL=redis://redis:6379/0
DEFAULT_MODEL=gpt-4o-mini
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
RATE_LIMIT_PER_MIN=60
EVAL_INTERVAL_SEC=3600
EVAL_REGRESSION_TOLERANCE=0.03
EVAL_MAX_ITEMS=50
EMBEDDING_MODEL=text-embedding-3-large
JUDGE_MODEL=gpt-4o-mini
COST_ROLLUP_INTERVAL_SEC=300
COST_ROLLUP_DAYS=7

# Privacy default: persist "[redacted]" instead of invocation prompts and model responses.
STORE_INVOCATION_CONTENT=false

# Explicit opt-in: the evaluation worker sends dataset inputs, expected answers, and model outputs
# to the configured invocation, embedding, and judge providers. Keep false unless approved.
ALLOW_EXTERNAL_EVAL_DATA=false
